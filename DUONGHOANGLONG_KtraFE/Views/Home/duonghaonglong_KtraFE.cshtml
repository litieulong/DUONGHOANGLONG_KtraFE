@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>duonghaonglong_KtraFE</title>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Amazon Ember", Arial, sans-serif;
        }

        body {
            background-color: #e3e6e6;
        }

        .navbar {
            height: 60px;
            background-color: #131921;
            color: white;
            display: flex;
            align-items: center;
            padding: 0 15px;
            gap: 15px;
        }

        .logo-text {
            font-size: 22px;
            font-weight: bold;
            color: #ff9900;
            cursor: pointer;
        }

        .nav-location {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            padding: 5px;
        }

        .line-1 {
            font-size: 12px;
            color: #ccc;
        }

        .line-2 {
            font-size: 14px;
            font-weight: bold;
            color: white;
        }

        .nav-search {
            display: flex;
            flex: 1;
            height: 40px;
            border-radius: 4px;
            overflow: hidden;
        }

        .search-select {
            background: #f3f3f3;
            border: none;
            padding: 0 10px;
            font-size: 12px;
            border-right: 1px solid #ddd;
            outline: none;
        }

        .search-input {
            width: 100%;
            border: none;
            padding: 0 10px;
            font-size: 15px;
            outline: none;
        }

        .search-btn {
            background-color: #febd69;
            border: none;
            width: 45px;
            cursor: pointer;
            font-size: 18px;
        }

            .search-btn:hover {
                background-color: #f3a847;
            }

        .nav-tools {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .nav-item {
            cursor: pointer;
        }

        .nav-cart {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
            font-weight: bold;
        }

            .nav-cart i {
                font-size: 22px;
            }

        .sub-nav {
            height: 39px;
            background-color: #232f3e;
            color: white;
            display: flex;
            align-items: center;
            padding: 0 15px;
        }

            .sub-nav ul {
                display: flex;
                list-style: none;
                gap: 18px;
                font-size: 14px;
            }

            .sub-nav li {
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 5px;
            }

 
        .hero-section {
            position: relative;
            width: 100%;
            height: 600px;
            background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, #e3e6e6 100%), url('https://images-na.ssl-images-amazon.com/images/G/01/AmazonExports/Events/2024/BAU2024/Toys_Desktop_Hero_2x._CB555555555_.jpg') no-repeat center top / cover;
        }

        .hero-content {
            padding: 20px;
        }

            .hero-content h2 {
                color: #0f1111;
            }


        .main-container {
            max-width: 1480px;
            margin: -350px auto 20px auto;
            padding: 0 20px;
            position: relative;
            z-index: 2;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .card {
            background: white;
            padding: 20px 20px 15px 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 420px;
        }

            .card h3 {
                font-size: 21px;
                font-weight: 700;
                color: #0f1111;
                line-height: 1.2;
                margin-bottom: 10px;
            }

        .card-img {
            height: 275px;
            background-size: cover;
            background-position: center;
            margin-bottom: 12px;
        }

        .card a {
            color: #007185;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
        }

            .card a:hover {
                color: #c7511f;
                text-decoration: underline;
            }

 
        .sub-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 10px;
            margin-bottom: 12px;
        }

            .sub-grid div {
                display: flex;
                flex-direction: column;
            }

                .sub-grid div img {
                    width: 100%;
                    height: 102px;
                    object-fit: cover;
                }

            .sub-grid p {
                font-size: 12px;
                color: #0f1111;
                margin-top: 4px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }


        .carousel-section {
            background: white;
            padding: 20px;
            margin-top: 20px;
        }

            .carousel-section h3 {
                font-size: 21px;
                font-weight: 700;
                margin-bottom: 12px;
                color: #0f1111;
            }

        .carousel-items {
            display: flex;
            gap: 18px;
            overflow-x: auto;
            padding-bottom: 10px;
        }

            .carousel-items::-webkit-scrollbar {
                height: 7px;
            }

            .carousel-items::-webkit-scrollbar-track {
                background: #f1f1f1;
            }

            .carousel-items::-webkit-scrollbar-thumb {
                background: #bbbbbb;
                border-radius: 4px;
            }

                .carousel-items::-webkit-scrollbar-thumb:hover {
                    background: #888888;
                }

        .item-card img {
            height: 200px;
            width: auto;
            object-fit: contain;
        }

        footer {
            background-color: #232f3e;
            color: white;
            margin-top: 40px;
        }

        .back-to-top {
            background-color: #37475a;
            text-align: center;
            padding: 15px 0;
            font-size: 13px;
            cursor: pointer;
        }

            .back-to-top:hover {
                background-color: #485769;
            }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 80px;
            padding: 40px 0;
            background-color: #131a22;
        }

        .footer-col h4 {
            margin-bottom: 10px;
            font-size: 16px;
            font-weight: bold;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            font-size: 13px;
            color: #ddd;
            margin-bottom: 8px;
            cursor: pointer;
        }

            .footer-col li:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
